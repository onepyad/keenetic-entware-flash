#!/bin/sh
# Activate a preformatted Linux SWAP partition; never format a device here.
ENABLED=yes
SWAPS_FILE=${SWAPS_FILE:-/proc/swaps}

find_swap_device() {
    command -v blkid >/dev/null 2>&1 || { echo "blkid is required to identify SWAP" >&2; return 1; }
    devices=$(blkid 2>/dev/null | awk '/LABEL="SWAP"/ && /TYPE="swap"/ {sub(/:$/, "", $1); print $1}')
    count=0
    candidate=""
    for device in $devices; do
        count=$((count + 1))
        candidate=$device
    done
    [ "$count" = 1 ] || { echo "Expected one Linux swap partition labeled SWAP; found $count" >&2; return 1; }
    [ -b "$candidate" ] || { echo "Not a block device: $candidate" >&2; return 1; }
    printf '%s\n' "$candidate"
}

is_active() {
    awk -v device="$1" '$1 == device {found=1} END {exit !found}' "$SWAPS_FILE"
}

start() {
    [ "$ENABLED" = yes ] || { echo "SWAP is disabled"; return 0; }
    device=$(find_swap_device) || return 1
    if is_active "$device"; then echo "SWAP already active on $device"; return 0; fi
    swapon "$device" || return 1
    echo "SWAP started on $device"
}

stop() {
    device=$(find_swap_device) || return 1
    if is_active "$device"; then swapoff "$device" || return 1; fi
    echo "SWAP stopped on $device"
}

if [ "${SWAP_SCRIPT_TESTING:-0}" != 1 ]; then
    case "${1:-}" in
        start) start ;;
        stop) stop ;;
        restart) stop && start ;;
        status) cat "$SWAPS_FILE"; free -m ;;
        *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
    esac
fi
